{
  "name": "mas-moriya-visual-portfolio-resume",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "security:check": "node scripts/security-boundary-check.mjs",
    "prebuild": "npm run security:check",
    "verify": "npm run security:check && npm audit --omit=dev --audit-level=high && npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "^16.3.2",
